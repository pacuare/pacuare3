# App database: authorized users, Google identities, and per-user space records.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pacuare_app

# Separate database holding the canonical `pacuare_raw` table. Read-only from
# this app -- each user's space gets its own copy of this table.
DATA_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pacuare_data

# Public origin this app is served from, used to build the Google OAuth
# callback URL.
APP_ORIGIN=http://localhost:44100

# Secret used to sign session cookies. Generate with e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Google OAuth2 client, from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_ORIGIN}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Docker daemon this app provisions per-user spaces against. The default
# socket path assumes the daemon is reachable there directly -- if this app
# itself runs in a container, bind-mount the host's socket in
# (`-v /var/run/docker.sock:/var/run/docker.sock`).
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_API_VERSION=v1.41

# Bridge network every space's container is attached to, so the app can
# reach marimo on each container's address. If this app itself runs in a
# container, that container needs to be attached to the same network too
# (or run with --network host) for the notebook proxy to reach spaces.
DOCKER_NETWORK=pacuare-spaces

# Image every space's container runs, built from ./notebook and published
# alongside this app's own image (see .buildkite/pipeline.yml). Settings ->
# "Update" re-pulls this image and recreates the container from it.
NOTEBOOK_IMAGE=pacuare3-notebook:latest

# Only needed if NOTEBOOK_IMAGE lives in a private registry (e.g. a
# Buildkite Package Registry token). DOCKER_REGISTRY_SERVER is optional and
# defaults to the host parsed out of NOTEBOOK_IMAGE itself -- set it
# explicitly only if that doesn't resolve to the right registry.
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=
DOCKER_REGISTRY_SERVER=
