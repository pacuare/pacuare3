{
  "name": "pacuare3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "node --import remix/node-tsx scripts/migrate.ts",
    "typecheck:workers": "tsc --noEmit -p workers/tsconfig.json",
    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "pg": "^8.13.0",
    "remix": "^3.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "latest",
    "@types/pg": "^8.11.0",
    "eslint": "^10.8.0",
    "playwright": "^1.62.1",
    "typescript": "latest",
    "typescript-eslint": "^8.66.0",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
